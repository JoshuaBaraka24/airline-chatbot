# Settings for the server. Copy this file to .env.production in the project
# root, fill it in, and deploy/push_server.ps1 uploads it as the server's .env.
# .env.production is ignored by Git, so your secrets are never committed.

# The server's public name (Azure: the DNS name of the VM's public IP)
SITE_ADDRESS=your-label.your-region.cloudapp.azure.com
ALLOWED_ORIGINS=https://your-label.your-region.cloudapp.azure.com

# Passwords for the demo accounts. Required: the defaults are in the public code.
DEMO_ADMIN_PASSWORD=
DEMO_PASSWORD=

# true reloads the demo data every time the system starts
RESET_DEMO_DATA=false

# Booking confirmation emails (Gmail works from Azure on port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_REDIRECT_TO=

# Sign in with Google: add GOOGLE_REDIRECT_URI to the OAuth client in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-label.your-region.cloudapp.azure.com/api/auth/google/callback

# Chat message limits (0 switches one off; the load test needs all three off).
# Everyone on one Wi-Fi network usually shares an address, so those limits are higher.
CHAT_PER_CONVERSATION_MINUTE=20
CHAT_PER_ADDRESS_MINUTE=60
CHAT_PER_ADDRESS_HOUR=600
