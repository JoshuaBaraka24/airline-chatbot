# Copy this file to .env and fill in your local values. Never commit .env.

# PostgreSQL connection used by the custom action server and the backend API
DB_NAME=airline_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# Rasa server the backend forwards messages to
# Use 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and adds ~2s per request
RASA_URL=http://127.0.0.1:5005

# Origins allowed to call the backend API (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Booking confirmation emails (optional). Without SMTP_HOST no email is sent, and the assistant says so.
# Gmail: smtp.gmail.com, port 587, your address as SMTP_USER and an app password as SMTP_PASSWORD
# (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Send every email to this one inbox (use it for demos). Without it, the sample accounts are not mailed.
EMAIL_REDIRECT_TO=
